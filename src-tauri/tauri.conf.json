{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProWorship",
  "version": "1.0.0",
  "identifier": "com.proworshipcast.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "ProWorship",
        "url": "splash.html",
        "width": 720,
        "height": 405,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "transparent": false,
        "shadow": false
      },
      {
        "label": "main",
        "title": "ProWorship",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/Processing.NDI.Lib.x64.dll",
      "resources/Processing.NDI.Lib.Licenses.txt"
    ]
  }
}
